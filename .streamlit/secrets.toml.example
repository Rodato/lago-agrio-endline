# Copia este archivo a .streamlit/secrets.toml (que está en .gitignore) y rellena.

# ── Fuente 1 · Typeform ─────────────────────────────────────────────────────
TYPEFORM_TOKEN = "tfp_..."
FORM_ID = "xxxxxxxx"

# Mapeo de preguntas del form de Typeform que el dashboard trata como hidden fields.
[field_refs]
# encuestador = "<field-ref>"
# colegio     = "<field-ref>"
# barrio      = "<field-ref>"

# ── Fuente 2 · KoboToolbox ──────────────────────────────────────────────────
KOBO_BASE = "https://kf.kobotoolbox.org"   # servidor global; usa eu.kobotoolbox.org para EU
KOBO_TOKEN = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
KOBO_ASSET_UID = "aXxxxxxxxxxxxxxxxxxxxx"

# ── Cobertura (cruce con línea de base) ─────────────────────────────────────
# Salt para hashear las llaves de identidad (HMAC) en dashboard/data/baseline_keys.parquet.
# DEBE ser el mismo con que se corrió scripts/cruce_cobertura.py para generar el parquet.
# Mantenlo secreto y estable; si lo rotas, regenera el parquet.
COVERAGE_SALT = "cambia-esto-por-una-cadena-larga-y-secreta"

# ── Metas opcionales (barra de progreso en AVANCE) ──────────────────────────
[goals]
total = 1500

[goals.por_comunidad]
# "Nombre comunidad" = 200

[kobo_goals]
# total = 1500
